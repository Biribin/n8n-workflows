    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const valid = ['Formation', 'Badge', 'Contrats', 'Pieces_identite', 'Certificats', 'Autres'];\nlet cat = ($input.item.json.text || 'Autres').trim().replace(/[^a-zA-Z_àâéèêëïîôùûüç]/g, '');\n\nif (!valid.includes(cat)) {\n  const low = cat.toLowerCase();\n  const match = valid.find(c => low.includes(c.toLowerCase()));\n  cat = match || 'Autres';\n}\n\nconst prev = $('Hash + Dedup').item.json;\nreturn {\n  json: {\n    category: cat,\n    folder_path: 'WhatsApp Docs/' + cat,\n    filename: prev.filename,\n    sender_phone: prev.sender_phone,\n    sender_name: prev.sender_name,\n    file_hash: prev.file_hash,\n    mime_type: prev.mime_type\n  },\n  binary: $('Hash + Dedup').item.binary\n};"
      },
