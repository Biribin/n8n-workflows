    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.actionLog) sd.actionLog = [];\n\nconst bp = $('Build Path').item.json;\nconst upload = $input.item.json;\n\nconst entry = {\n  date: new Date().toISOString(),\n  filename: bp.filename,\n  category: bp.category,\n  sender: bp.sender_name + ' (' + bp.sender_phone + ')',\n  hash: bp.file_hash,\n  onedrive_url: upload.webUrl || '',\n  status: 'OK'\n};\n\nsd.actionLog.push(entry);\nif (sd.actionLog.length > 500) sd.actionLog = sd.actionLog.slice(-500);\n\nreturn { json: entry };"
      },
