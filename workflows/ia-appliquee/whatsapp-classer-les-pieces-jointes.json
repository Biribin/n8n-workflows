    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst sd = $getWorkflowStaticData('global');\nif (!sd.fileHashes) sd.fileHashes = {};\n\nlet hash = 'no_binary';\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer('data');\n  hash = crypto.createHash('md5').update(buf).digest('hex');\n} catch(e) {\n  hash = 'err_' + Date.now();\n}\n\nconst isDup = !!sd.fileHashes[hash];\nif (!isDup) {\n  sd.fileHashes[hash] = { \n    filename: $('Parse WhatsApp').item.json.filename,\n    date: new Date().toISOString()\n  };\n}\n\nreturn {\n  json: {\n    ...$('Parse WhatsApp').item.json,\n    file_hash: hash,\n    is_duplicate: isDup\n  },\n  binary: $input.item.binary\n};"
      },
