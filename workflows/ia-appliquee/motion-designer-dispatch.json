      "parameters": {
        "jsCode": "var item = items[0].json;\nvar headers = item.headers || {};\nvar body = item.body || {};\nif (!headers[\"x-internal-token\"]) {\n  throw new Error(\"Jeton interne absent : en-tête x-internal-token manquant sur l'appel webhook\");\n}\nvar jobId = body.jobId;\nvar sourcePath = body.sourcePath;\nvar outputPath = body.outputPath;\nif (typeof jobId !== \"string\" || jobId.length === 0) {\n  throw new Error(\"Payload webhook invalide : jobId manquant ou vide\");\n}\nif (typeof sourcePath !== \"string\" || sourcePath.length === 0) {\n  throw new Error(\"Payload webhook invalide : sourcePath manquant ou vide\");\n}\nif (typeof outputPath !== \"string\" || outputPath.length === 0) {\n  throw new Error(\"Payload webhook invalide : outputPath manquant ou vide\");\n}\nvar camera = (body.camera && typeof body.camera === \"object\" && Array.isArray(body.camera.moves)) ? body.camera : { moves: [] };\nvar clicks = Array.isArray(body.clicks) ? body.clicks : [];\nvar editPlan = {\n  version: 1,\n  jobId: jobId,\n  source: { path: sourcePath },\n  output: { path: outputPath, profile: \"final\" },\n  timeline: [],\n  camera: camera,\n  clicks: clicks\n};\nreturn [{ json: { jobId: jobId, editPlan: editPlan } }];\n"
      },
      "id": "8be7a6ea-196d-4598-b86d-515936950105",
