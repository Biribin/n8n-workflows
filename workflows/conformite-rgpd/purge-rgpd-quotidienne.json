        "jsCode": "// OK — purge quotidienne. Le body porte le détail par table :\n// passwordResetToken / invitation / notification = { deleted:N } | { skipped:'table_absente' } | { error:... }\n// totalDeleted = nombre total de lignes supprimées ce run.\nconst r = $json;\nreturn [{ json: {\n  statut: 'OK',\n  scope: r.scope,\n  totalDeleted: r.totalDeleted,\n  passwordResetToken: r.passwordResetToken,\n  invitation: r.invitation,\n  notification: r.notification\n} }];"
