      "parameters": {
        "jsCode": "// OK — purge mensuelle des journaux. Le body porte le détail :\n// authLog / adminAuditLog = { deleted:N } | { skipped:'table_absente' } | { error:... }\n// NB : { deleted:0 } est NORMAL tant qu'aucune ligne n'a dépassé la rétention\n// (12 mois AuthLog / 36 mois AdminAuditLog). Ce n'est pas une anomalie.\nconst r = $json;\nreturn [{ json: {\n  statut: 'OK',\n  scope: r.scope,\n  totalDeleted: r.totalDeleted,\n  cutoffs: r.cutoffs,\n  authLog: r.authLog,\n  adminAuditLog: r.adminAuditLog\n} }];"
      },
